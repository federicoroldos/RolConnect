{
  "manifest_version": 3,
  "name": "RolConnect — AI New Tab & Browsing Agent",
  "short_name": "RolConnect",
  "version": "0.4.0",
  "description": "Your new tab and side panel as an AI agent that searches the web, reads pages and uses your tabs. Claude, GPT and more through OpenCode Zen or OpenCode Go.",
  "homepage_url": "https://github.com/federicoroldos/RolConnect",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "sidePanel",
    "contextMenus",
    "favicon",
    "tabGroups",
    "alarms",
    "notifications",
    "debugger"
  ],
  "optional_permissions": ["history"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open RolConnect in the side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Open the RolConnect side panel"
    }
  }
}
